# Copy this file to .env and fill in the values. Never commit .env.

# The bot's secret password (Discord Developer Portal -> your app -> Bot -> Reset Token).
# Never share it, never paste it into a chat, never commit it.
DISCORD_TOKEN=put-your-bot-token-here

# The number of the one channel the bot listens to (right-click the channel -> Copy Channel ID).
CHANNEL_ID=123456789012345678

# The Claude model that `claude -p` should use.
CLAUDE_MODEL=put-a-model-name-here

# A folder on your computer for photos/, vehicle_log.xlsx and pending_rows.jsonl.
# Keep it outside the project folder.
DATA_DIR=C:\Users\User\Documents\vehicle-photo-data
